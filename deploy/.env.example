# Postgres
POSTGRES_PASSWORD=dmn_rules

# AI provider: anthropic | openai | ollama. These are only the STARTING values: once an admin
# saves a provider in the admin console (/admin), that choice is stored in the database and wins on
# every later start. Keys are only ever read from here (never typed into the app or stored in the
# DB); a provider whose key is blank cannot be selected in the console. Everything except Ask AI /
# Ask Bob (Rules, Audit, Dashboard, evaluate/simulate) works without any key.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini (key from Google AI Studio). Calls go to Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=

# LLM spend guard: one monthly budget in USD across all providers (calendar month, UTC). Every model
# call, including each tool-calling round, is priced from the admin console's price table and
# recorded; once the month's spend reaches the budget, Ask Bob stops calling paid providers until
# the 1st (self-hosted Ollama keeps working). These are starting values; the admin console can change
# them. Also set a hard spend limit in each provider's own console as a second line of defence.
AI_MONTHLY_BUDGET_USD=25
AI_BUDGET_WARN_PERCENT=80
# Where a self-hosted Ollama runs, as seen from the ai-service container. The default reaches
# Ollama on the Docker host. The admin console can override it per setting.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Admin console (/admin, LLM provider settings) -- only the 'admin' account can open it, and the
# server verifies a signed session token, not just the username. Set a strong password: if left
# blank, a random one is generated on every start and printed once in the decision-service log
# ("Generated admin password for this run"). The demo users' shared password never works for admin.
DEMO_ADMIN_PASSWORD=
# HMAC secret for session tokens. Blank = random per start (sessions end on restart). Must be set
# when running more than one decision-service instance. Use a long random string.
AUTH_TOKEN_SECRET=

# REST API authentication. Every /api call needs HTTP Basic (username:password) or a login token;
# see Help -> REST API in the app. 'api-client' is the account for integrations (evaluate, simulate
# and read only; it cannot sign in to the web app). Blank = random per start, printed once in the
# decision-service log ("Generated password for 'api-client'").
API_CLIENT_PASSWORD=
# ai-service's own credential for calling decision-service. Any long random string; both services
# read this same variable. Required by docker-compose.prod.yml; the local docker-compose.yml falls
# back to a fixed local-only value when it is unset.
AI_SERVICE_PASSWORD=

# Public domain for the production deploy (docker-compose.prod.yml). Caddy requests a Let's
# Encrypt certificate for this exact hostname, so it must be a real DNS A record pointing at the
# VM's public IP -- not localhost or a bare IP address, which Caddy will not issue a cert for.
# Not used by the plain docker-compose.yml (local/dev), which stays on plain HTTP.
DEMO_DOMAIN=demo.example.com

# RESET_DEMO_ON_START=true (default) wipes and reseeds all demo data on every container restart,
# so a public demo always comes back clean however a previous visitor left it. Set to false to
# preserve manually authored drafts/approvals across restarts (docs/DECISIONS.md M6).
RESET_DEMO_ON_START=true
