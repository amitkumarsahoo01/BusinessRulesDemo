# Postgres
POSTGRES_PASSWORD=dmn_rules

# AI provider. Only Anthropic is actually wired right now (docs/DECISIONS.md M5) -- AI_PROVIDER
# is accepted for forward-compat with the full architecture's provider-agnostic design but isn't
# read yet. A real key is required for the chat/"Ask AI" feature to answer anything; everything
# else in the demo (Rules, Audit, evaluate/simulate) works without one.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public domain for the production deploy (docker-compose.prod.yml). Caddy requests a Let's
# Encrypt certificate for this exact hostname, so it must be a real DNS A record pointing at the
# VM's public IP -- not localhost or a bare IP address, which Caddy will not issue a cert for.
# Not used by the plain docker-compose.yml (local/dev), which stays on plain HTTP.
DEMO_DOMAIN=demo.example.com

# RESET_DEMO_ON_START=true (default) wipes and reseeds all demo data on every container restart,
# so a public demo always comes back clean however a previous visitor left it. Set to false to
# preserve manually authored drafts/approvals across restarts (docs/DECISIONS.md M6).
RESET_DEMO_ON_START=true
